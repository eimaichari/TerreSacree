---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import Footer from '../../../components/Footer.astro';
import { church } from '../../../data/church';
---

<BaseLayout title={`Youth Sunday Details`} stylesheet="/styles/upcoming-events.css" script="/scripts/upcoming-events.js">
<header class="hero" style="height: 60vh;">
        <div class="background-image">
            <img src="/photos/events/Screenshot 2025-07-04 at 10.07.05 PM.png" alt="Generic Background Image">
        </div>
        <div class="hero-overlay">
            <div class="hero-top">
                <div class="logo"><a href="/index.html" style="color: white; text-decoration: none;">LOGO</a></div>
            </div>
            <div class="event-hero-graphic">
                <img src="https://via.placeholder.com/800x400/FF00FF/FFFFFF?text=SILLY+SUNDAY+GRAPHIC" alt="Silly Sunday Event Title Graphic">
                </div>
        </div>
    </header>
    <Navigation />

    <main class="event-detail-content">
        <div class="event-detail-header">
            <h1>YTH Sunday Night Live</h1>
            <p>On the last Sunday of each month, Motivation YTH gets together for a BIG Night filled with a full worship set, interactive teaching, games and food. You don't want to miss out!</p>
            <div class="event-meta-info">
                <p><span class="icon">&#128467;</span> JUL 13, 2025</p>
                <p><span class="icon">&#128205;</span> MOTIVATION CHURCH</p>
                <p><span class="icon">&#9200;</span> 9:30 AM</p>
            </div>
        </div>

        <section class="event-description">
            <h3>About This Event</h3>
            <p>Get ready for a day of fun and laughter at Silly Sunday! We encourage all kids to come dressed in their most creative, wacky, and silliest outfits. There will be special activities, games, and surprises for everyone participating. It's a fantastic opportunity for our young ones to express themselves and enjoy a joyful time together.</p>
            <p>Don't forget your camera to capture all the amazing silly outfits! We can't wait to see you there!</p>
        </section>
    </main>
    <Footer />
</BaseLayout>
