---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { church } from '../../data/church';
---

<BaseLayout title={`Shop | ${church.name}`} stylesheet="/styles/shop.css" script="/scripts/shop.js">
<header class="hero">
        <div class="hero-background" style="background-image: url('/photos/page-hero/Merch.jpg');">
            <!-- Still background image -->
        </div>
        <div class="hero-content-wrapper">
            <div class="hero-overlay-content animate-on-scroll" id="hero-content">
                <h1>{church.name} Shop</h1>
                <p>Explore exclusive merchandise to support our community and spread the love.</p>
                <a href="#shop-items" class="btn">Browse Collection</a>
            </div>
        </div>
        <div class="cart-icon" id="cart-icon">
            <span>🛒</span> (<span id="cart-count">0</span>)
        </div>
    </header>
    <Navigation />
    <section id="shop-items" class="animate-on-scroll">
        <h2>Our Collection</h2>
        <p>Discover unique items crafted with faith and purpose.</p>
        <div class="shop-grid">
            <div class="shop-card">
                <img src="/photos/tshirt.jpg" alt="Faith T-Shirt" class="shop-image" onerror="this.src='https://placehold.co/300x300/cccccc/333333?text=T-Shirt';">
                <h3>Faith T-Shirt</h3>
                <p class="price">$19.99</p>
                <button class="add-to-cart btn">Add to Cart</button>
            </div>
            <div class="shop-card">
                <img src="/photos/mug.jpg" alt="Hope Mug" class="shop-image" onerror="this.src='https://placehold.co/300x300/cccccc/333333?text=Mug';">
                <h3>Hope Mug</h3>
                <p class="price">$12.99</p>
                <button class="add-to-cart btn">Add to Cart</button>
            </div>
            <div class="shop-card">
                <img src="/photos/bracelet.jpg" alt="Love Bracelet" class="shop-image" onerror="this.src='https://placehold.co/300x300/cccccc/333333?text=Bracelet';">
                <h3>Love Bracelet</h3>
                <p class="price">$9.99</p>
                <button class="add-to-cart btn">Add to Cart</button>
            </div>
            <!-- New Products -->
            <div class="shop-card">
                <img src="/photos/hat.jpg" alt="Peace Hat" class="shop-image" onerror="this.src='https://placehold.co/300x300/cccccc/333333?text=Hat';">
                <h3>Peace Hat</h3>
                <p class="price">$15.99</p>
                <button class="add-to-cart btn">Add to Cart</button>
            </div>
            <div class="shop-card">
                <img src="/photos/notebook.jpg" alt="Faith Notebook" class="shop-image" onerror="this.src='https://placehold.co/300x300/cccccc/333333?text=Notebook';">
                <h3>Faith Notebook</h3>
                <p class="price">$8.99</p>
                <button class="add-to-cart btn">Add to Cart</button>
            </div>
            <div class="shop-card">
                <img src="/photos/totebag.jpg" alt="Hope Tote Bag" class="shop-image" onerror="this.src='https://placehold.co/300x300/cccccc/333333?text=Tote+Bag';">
                <h3>Hope Tote Bag</h3>
                <p class="price">$14.99</p>
                <button class="add-to-cart btn">Add to Cart</button>
            </div>
        </div>
    </section>
    
    <section id="checkout" class="animate-on-scroll">
        <h2>Checkout</h2>
        <form id="checkout-form" class="checkout-form">
            <div class="form-group">
                <label for="name">Full Name</label>
                <input type="text" id="name" required>
            </div>
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" required>
            </div>
            <div class="form-group">
                <label for="address">Address</label>
                <input type="text" id="address" required>
            </div>
            <button type="submit" class="btn submit-btn">Place Order</button>
        </form>
    </section>
    <Footer />
</BaseLayout>
