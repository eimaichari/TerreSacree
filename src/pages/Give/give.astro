---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { church } from '../../data/church';
---

<BaseLayout title={`Give | ${church.name}`} stylesheet="/styles/give.css" script="/scripts/give.js">
<header class="hero">
        <div class="hero-background" style="background-image: url('/photos/page-hero/Give.jpg');">
            <!-- Still background image -->
        </div>
        <div class="hero-content-wrapper">
            <div class="hero-overlay-content animate-on-scroll" id="hero-content">
                <h1>Give to {church.name}</h1>
                <p>Support our mission with your generous contribution.</p>
                <a href="#give-form" class="btn">Donate Now</a>
            </div>
        </div>
        <div class="cart-icon" id="cart-icon">
            <span>🛒</span> (<span id="cart-count">0</span>)
        </div>
    </header>
    <Navigation />
    <section id="give-content" class="animate-on-scroll">
        <h2>Make a Difference</h2>
        <p>Your support helps us grow our community and spread hope. Every gift counts!</p>
        <div class="give-form-container">
            <form id="give-form" class="give-form">
                <div class="form-group">
                    <label for="amount">Donation Amount ($)</label>
                    <input type="number" id="amount" min="1" placeholder="Enter amount" required>
                </div>
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" required>
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" required>
                </div>
                <button type="submit" class="btn submit-btn">Donate</button>
            </form>
        </div>
        <p class="inspiration">“For where your treasure is, there your heart will be also.” – Matthew 6:21</p>
    </section>
    <section id="connect" class="animate-on-scroll">
        <h2>Connect with Us</h2>
        <p>Stay in touch—share your phone number to receive updates!</p>
        <form id="connect-form" class="connect-form">
            <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="tel" id="phone" placeholder="+1 (555) 123-4567" required>
            </div>
            <button type="submit" class="btn submit-btn">Submit</button>
        </form>
    </section>
    <section id="checkout" class="animate-on-scroll">
        <h2>Checkout</h2>
        <form id="checkout-form" class="checkout-form">
            <div class="form-group">
                <label for="name">Full Name</label>
                <input type="text" id="name" required>
            </div>
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" required>
            </div>
            <div class="form-group">
                <label for="address">Address</label>
                <input type="text" id="address" required>
            </div>
            <button type="submit" class="btn submit-btn">Place Order</button>
        </form>
    </section>
    <Footer />
</BaseLayout>
