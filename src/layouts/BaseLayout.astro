---
interface Props {
  title: string;
  stylesheet: string;
  script?: string;
}

const { title, stylesheet, script } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css?family=Poppins:400,700,800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Inter:400,700,800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={stylesheet} />
    <link rel="stylesheet" href="/styles/navigation.css" />
    {script && <script src={script}></script>}
    <script is:inline src="/scripts/navigation.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>
